# ============================================
# 糖果图库后端环境变量样例（项目唯一入口）
# 复制为 .env 并按需填写；本地开发最少只需设置 JWT_SECRET + URL_SIGN_SECRET
# Docker / Vercel / Railway 等部署平台也是同一份变量
# ============================================

# ===== 服务基础 =====
# 端口（默认 3000）
PORT=3000

# ===== 认证（必填，fail-closed：未设服务拒绝启动）=====
# JWT 签名密钥
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# JWT 过期时间，默认 2d
JWT_EXPIRES_IN=2d

# /uploads 文件签名 URL 密钥（避免 <img> 无法带 Authorization 头）
# 与 JWT_SECRET 独立（职责分离）。未设服务拒绝启动。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
URL_SIGN_SECRET=

# 签名 URL 有效期（秒），默认 3600 = 1 小时
# 覆盖「列表拉取 → 图片实际加载」的最大间隔；太短会导致懒加载的图过期 401
SIGNED_URL_TTL=3600

# ===== 注册管控 =====
# 公开注册开关：false=关闭（推荐，私有图库，账号用 _create-user.js 建）；true=开放注册
REG_OPEN=false

# ===== CORS（仅前后端跨域时需要）=====
# 同域部署（vite proxy / nginx 反代 /uploads 和 /api）下 CORS 不生效，可留空。
# 前后端跨域时设为前端域名以收紧，例：https://gallery.example.com
CORS_ORIGIN=

# ===== 存储 =====
# 本地存储配额（MB）。仅 STORAGE_TYPE=local 时生效（OSS 弹性容量不限）；0 = 不限
UPLOAD_QUOTA_MB=0

# local（默认）：写到 server/uploads/，由 Express 静态服务
# cos：写到腾讯云对象存储 COS（需要下方 COS_* 配置）
STORAGE_TYPE=local

# 腾讯云 COS（仅 STORAGE_TYPE=cos 时生效）
# 桶需设为公有读，否则返回的公网 URL 浏览器访问会 403
# 取消注释并填入真实值
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=my-gallery-1250000000   # 格式：name-appId
# COS_REGION=ap-guangzhou            # 如 ap-shanghai / ap-beijing
# COS_PREFIX=candy/                  # bucket 内的子目录前缀，可选
