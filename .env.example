# ===== 服务端配置 =====
# 所有变量都有默认值，不填也能本地跑通。
# 复制为 .env 后填入真实值；docker compose 也会读它。

# 端口（默认 3000）
PORT=3000

# JWT 签名密钥（默认 dev key，生产务必改！）
# 生成一个： node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=candy-gallery-dev-secret-change-me-in-prod

# /uploads 文件签名 URL 密钥（用于签名图片/视频 URL，避免 <img> 无法带 Authorization 头）
# 独立于 JWT_SECRET（职责分离）。生产务必改。
# 生成一个： node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
URL_SIGN_SECRET=

# 文件签名 URL 有效期（秒，默认 3600 = 1 小时）
SIGNED_URL_TTL=3600

# ===== 存储后端 =====
# local（默认）：写到 server/uploads/，由 Express 静态服务
# cos：写到腾讯云对象存储 COS
STORAGE_TYPE=local

# 腾讯云 COS（仅 STORAGE_TYPE=cos 时生效）
# 桶需设为公有读，否则返回的公网 URL 浏览器访问会 403
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=                # 格式：name-1250000000
COS_REGION=ap-guangzhou    # 如 ap-shanghai / ap-beijing
COS_PREFIX=candy/          # bucket 内的子目录前缀，可选
