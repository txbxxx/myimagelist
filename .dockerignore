# 不要把测试数据 / 本地产物带进镜像
.git
.gitignore
.env
.env.local
.vscode
.idea
.DS_Store
*.log
*.md.bak

# 本地依赖（容器内重新装）
node_modules
**/node_modules

# 运行时数据（每个容器自己的）
server/db.sqlite
server/db.sqlite-shm
server/db.sqlite-wal
server/db.json
server/db.json.bak
server/uploads/*
!server/uploads/.gitkeep

# 前端构建产物（容器内 pnpm build 生成）
client/dist

# 本文件也忽略
Dockerfile*
docker-compose*
.dockerignore
